diff --git a/src/present.c b/src/present.c
index 89f7543..0e0fb87 100644
--- a/src/present.c
+++ b/src/present.c
@@ -79,6 +79,9 @@ typedef struct {
 } Present;
 
 static Present present;
+// The emulated kernel implements VdSwap without a physical display controller.
+static bool swap_only;
+static bool swap_pending[XSDK_PRESENT_MAX_BUFFERS];
 
 // What D3D tells XAM about the title's display, 64 bytes, which XAM draws the frame under the Guide by: the front
 // buffer's size and the output's, then the scaler between them, the front buffer's corners, the output's size and the
@@ -181,9 +184,17 @@ NTSTATUS xsdk_present_open(
 	assert(swap_interval >= 1 && swap_interval <= 2);
 	const bool splash_held = mode == XSDK_DISPLAY_720P && xsdk_splash_hand_over(width, height);
 	const NTSTATUS status = splash_held ? STATUS_SUCCESS : xsdk_display_open(mode, width, height);
-	if (!NT_SUCCESS(status))
+	swap_only = !splash_held && mode == XSDK_DISPLAY_720P &&
+		(status == STATUS_IO_TIMEOUT || status == STATUS_NOT_SUPPORTED);
+	if (swap_only) {
+		*width = 1280;
+		*height = 720;
+		for (uint32_t i = 0; i < buffer_count; i++) swap_pending[i] = false;
+		xsdk_log_write("present: using 720p VdSwap without display-controller flips (0x%08X)", (unsigned)status);
+	} else if (!NT_SUCCESS(status)) {
 		return status;
-	const bool letterbox = xsdk_display_letterboxed();
+	}
+	const bool letterbox = !swap_only && xsdk_display_letterboxed();
 	present = (Present){ .buffer_count = buffer_count,
 		.swap_interval = swap_interval,
 		.width = *width,
@@ -193,15 +204,15 @@ NTSTATUS xsdk_present_open(
 		// The splash's logo shows at 1280x720, so the first flip changes the scale, as after XAM's surface.
 		.showed_system = splash_held && letterbox };
 	// XAM is told of the whole front buffer, bars and all, as VdSwap hands it over.
-	present.sized = xsdk_display_plan(present.width, present.height, present.width, &present.own_size);
-	describe_display(present.width, present.height);
+	present.sized = !swap_only && xsdk_display_plan(present.width, present.height, present.width, &present.own_size);
+	if (!swap_only) describe_display(present.width, present.height);
 	const uint32_t pixels = xsdk_gpu_resolve_bytes(present.width, present.height) / 4;
 	for (uint32_t i = 0; i < buffer_count; i++) {
 		present.buffers[i] = xsdk_gpu_alloc(pixels * 4);
 		if (!present.buffers[i]) {
 			for (uint32_t j = 0; j < i; j++)
 				xsdk_gpu_free(present.buffers[j]);
-			xsdk_display_close();
+			if (!swap_only) xsdk_display_close();
 			if (splash_held)
 				xsdk_splash_free();
 			return STATUS_NO_MEMORY;
@@ -212,12 +223,12 @@ NTSTATUS xsdk_present_open(
 	}
 	__asm__ volatile("sync" ::: "memory");
 	// The last buffer stands for frame -1, so frame 0 resolves into the first; the splash's logo stands in for it.
-	if (!splash_held && letterbox)
+	if (!swap_only && !splash_held && letterbox)
 		(void)xsdk_display_show_sized(present.addresses[buffer_count - 1], &present.own_size);
-	else if (!splash_held)
+	else if (!swap_only && !splash_held)
 		(void)xsdk_display_show(present.addresses[buffer_count - 1], *width);
 	present.open = true;
-	VdSetGraphicsInterruptCallback(on_interrupt, NULL);
+	if (!swap_only) VdSetGraphicsInterruptCallback(on_interrupt, NULL);
 	return STATUS_SUCCESS;
 }
 
@@ -239,6 +250,16 @@ NTSTATUS xsdk_present_begin(uint32_t *address, uint32_t timeout_ms)
 	assert(present.open);
 	release_splash();
 	const uint32_t frame = present.queued;
+	if (swap_only) {
+		const uint32_t i = frame % present.buffer_count;
+		if (swap_pending[i]) {
+			const NTSTATUS ready = xsdk_gpu_wait(present.fences[i], timeout_ms);
+			if (!NT_SUCCESS(ready)) return ready;
+			swap_pending[i] = false;
+		}
+		*address = present.addresses[i];
+		return STATUS_SUCCESS;
+	}
 	const uint32_t needed = frame - present.buffer_count + 2;
 	struct timespec start;
 	(void)clock_gettime(CLOCK_MONOTONIC, &start);
@@ -274,6 +295,14 @@ void xsdk_present_end(void)
 	assert(present.open);
 	const uint32_t frame = present.queued;
 	const uint32_t index = frame % present.buffer_count;
+	if (swap_only) {
+		GpuSurface unused;
+		(void)xsdk_gpu_swap(present.buffers[index], present.width, present.height, &unused);
+		present.fences[index] = xsdk_gpu_fence();
+		swap_pending[index] = true;
+		present.queued++;
+		return;
+	}
 	Shown *const shown = &present.shown[frame % QUEUE_SLOTS];
 	*shown = (Shown){ .address = present.addresses[index], .size = present.own_size };
 	GpuSurface system;
@@ -313,6 +342,17 @@ void xsdk_present_close(void)
 {
 	if (!present.open)
 		return;
+	if (swap_only) {
+		for (uint32_t i = 0; i < present.buffer_count; i++) {
+			if (swap_pending[i] && !NT_SUCCESS(xsdk_gpu_wait(present.fences[i], CLOSE_TIMEOUT_MS))) {
+				xsdk_log_write("present: retaining busy swap buffer %u at shutdown", (unsigned)i);
+				continue;
+			}
+			xsdk_gpu_free(present.buffers[i]);
+		}
+		present.open = false;
+		return;
+	}
 	present.stopping = true;
 	for (uint32_t waited_ms = 0; present.flipped != present.queued && waited_ms < CLOSE_TIMEOUT_MS; waited_ms++)
 		(void)xsdk_thread_sleep(1);
