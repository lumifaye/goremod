diff --git a/CMakeLists.txt b/CMakeLists.txt
index e45b53e..db9631b 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -2507,6 +2507,15 @@ elseif(RISCOS)
     CheckOSS()
   endif()
 
+elseif(XSDK)
+  # libxsdk provides POSIX threads and monotonic time. The game's native
+  # backends, not SDL, own the display, sound output and XAM controllers.
+  CheckPTHREAD()
+  set(SDL_TIMER_UNIX 1)
+  set(HAVE_SDL_TIMERS TRUE)
+  set(HAVE_CLOCK_GETTIME 1)
+  set(HAVE_NANOSLEEP 1)
+  list(APPEND SOURCE_FILES "${SDL2_SOURCE_DIR}/src/timer/unix/SDL_systimer.c")
 elseif(VITA)
   # SDL_spinlock.c Needs to be compiled in ARM mode.
   cmake_push_check_state(RESET)
diff --git a/cmake/sdlchecks.cmake b/cmake/sdlchecks.cmake
index ea4c0ff..6134e89 100644
--- a/cmake/sdlchecks.cmake
+++ b/cmake/sdlchecks.cmake
@@ -983,7 +983,7 @@ macro(CheckPTHREAD)
     elseif(EMSCRIPTEN)
       set(PTHREAD_CFLAGS "-D_REENTRANT -pthread")
       set(PTHREAD_LDFLAGS "-pthread")
-    elseif(QNX)
+    elseif(QNX OR XSDK)
       # pthread support is baked in
     else()
       set(PTHREAD_CFLAGS "-D_REENTRANT")
